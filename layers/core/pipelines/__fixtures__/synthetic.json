{
  "pipelines": {
    "activateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authn.activateUser",
      "events.emit:user.activated",
      "events.relay"
    ],
    "adminSchemaModel": [
      "authn.requireUser",
      "content.describeModel",
      "authz.describePipelineAccess"
    ],
    "applyMigrations": [
      "authn.requireUser",
      "authz.require:migrations.manage",
      "migrations.apply"
    ],
    "changePassword": [
      "authn.requireUser",
      "authn.changePassword",
      "events.emit:user.passwordChanged",
      "events.relay"
    ],
    "cleanupSessions": [
      "authn.cleanupSessions"
    ],
    "confirmPassword": [
      "authn.requireUser",
      "authn.confirmPassword"
    ],
    "createMediaFolder": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.createFolder"
    ],
    "createNews": [
      "authn.requireUser",
      "authz.require:news.write",
      "validate.check:news.body",
      "validate.sanitize:news.body",
      "validate.check:news.body",
      {
        "atomic": [
          "content.create:news"
        ]
      },
      "events.emit:news.created",
      "events.relay"
    ],
    "createPage": [
      "authn.requireUser",
      "authz.require:pages.write",
      "validate.check:pages.body",
      "validate.sanitize:pages.body",
      "validate.check:pages.body",
      {
        "atomic": [
          "content.create:pages",
          "site.indexPath:pages"
        ]
      },
      "site.announcePaths",
      "events.emit:page.created",
      "events.relay"
    ],
    "createUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authz.validateRoles:roles",
      "authn.createUser",
      "events.emit:user.created",
      "events.relay"
    ],
    "deactivateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authn.deactivateUser",
      "events.emit:user.deactivated",
      "events.relay"
    ],
    "deleteMedia": [
      "authn.requireUser",
      "authz.require:media.delete",
      "media.remove",
      "events.emit:media.deleted",
      "events.relay"
    ],
    "deleteMediaFolder": [
      "authn.requireUser",
      "authz.require:media.delete",
      "media.listFolderItems",
      "media.removeFolder",
      "events.emit:media.deleted",
      "events.relay"
    ],
    "deleteNews": [
      "authn.requireUser",
      "authz.require:news.delete",
      {
        "atomic": [
          "content.remove:news"
        ]
      },
      "events.emit:news.deleted",
      "events.relay"
    ],
    "deleteNewsTranslation": [
      "authn.requireUser",
      "authz.require:news.write",
      {
        "atomic": [
          "content.removeTranslation:news"
        ]
      },
      "events.emit:news.translationRemoved",
      "events.relay"
    ],
    "deletePage": [
      "authn.requireUser",
      "authz.require:pages.delete",
      {
        "atomic": [
          "content.remove:pages",
          "site.indexPath:pages"
        ]
      },
      "site.announcePaths",
      "events.emit:page.deleted",
      "events.relay"
    ],
    "deletePageTranslation": [
      "authn.requireUser",
      "authz.require:pages.write",
      {
        "atomic": [
          "content.removeTranslation:pages",
          "site.indexPath:pages"
        ]
      },
      "site.announcePaths",
      "events.emit:page.translationRemoved",
      "events.relay"
    ],
    "deleteUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authn.deleteUser",
      "events.emit:user.deleted?with=result",
      "events.relay"
    ],
    "downloadMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.download",
      "authz.fields:mediaFile?shape=file"
    ],
    "eventsDeliveryStatus": [
      "authn.requireUser",
      "authz.require:system.manage",
      "events.readDeliveryStatus"
    ],
    "exportMedia": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.export:<exportDir>"
    ],
    "getMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.get",
      "authz.fields:media?shape=item"
    ],
    "getNotifications": [
      "authn.identifyUser",
      "authz.require:notifications.read",
      "content.get:notifications",
      "authz.fields:notifications?shape=item"
    ],
    "getProfile": [
      "authn.identifyUser",
      "authz.require:profile.read",
      "content.get:profile",
      "authz.fields:profile?shape=item"
    ],
    "getRedirects": [
      "authn.identifyUser",
      "authz.require:redirects.read",
      "content.get:redirects",
      "authz.fields:redirects?shape=item"
    ],
    "getSettings": [
      "authn.identifyUser",
      "authz.require:settings.read",
      "content.get:settings",
      "site.resolveLinks:settings?home=home&status=published&fallback=true",
      "authz.fields:settings?shape=item"
    ],
    "getUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.getUser"
    ],
    "listAllNews": [
      "authn.requireUser",
      "authz.require:news.manage",
      "content.list:news"
    ],
    "listAllPages": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "content.list:pages",
      "site.attachPaths:pages"
    ],
    "listAutoRedirects": [
      "authn.requireUser",
      "authz.require:redirects.read",
      "redirects.listAuto"
    ],
    "listMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.list",
      "authz.fields:media?shape=list"
    ],
    "listMediaFolders": [
      "authn.requireUser",
      "authz.require:media.read",
      "media.listFolders"
    ],
    "listMigrations": [
      "authn.requireUser",
      "authz.require:migrations.manage",
      "migrations.list"
    ],
    "listNews": [
      "authn.identifyUser",
      "authz.require:news.read",
      "content.list:news?status=published",
      "authz.fields:news?shape=list"
    ],
    "listPages": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "content.list:pages?status=published",
      "site.attachPaths:pages?reachable",
      "authz.fields:pages?shape=list"
    ],
    "listUsers": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.listUsers"
    ],
    "login": [
      "authn.login",
      "events.emit:auth.loggedIn",
      "events.relay"
    ],
    "logout": [
      "authn.requireUser",
      "authn.logout",
      "events.emit:auth.loggedOut",
      "events.relay"
    ],
    "me": [
      "authn.requireUser",
      "authn.loadIdentity"
    ],
    "pathsMovedRedirects": [
      "redirects.recordMoves",
      "redirects.export"
    ],
    "previewPagePath": [
      "authn.requireUser",
      "authz.require:pages.write",
      "site.previewPath:pages"
    ],
    "readAnyNews": [
      "authn.requireUser",
      "authz.require:news.manage",
      "content.get:news"
    ],
    "readAnyPage": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "content.get:pages",
      "site.attachPaths:pages"
    ],
    "readNews": [
      "authn.identifyUser",
      "authz.require:news.read",
      "content.get:news?status=published",
      "authz.fields:news?shape=item"
    ],
    "readPage": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "content.get:pages?status=published",
      "site.attachPaths:pages?reachable",
      "authz.fields:pages?shape=item"
    ],
    "rebuildPaths": [
      "authn.requireUser",
      "authz.require:system.manage",
      "site.planRebuild",
      {
        "atomic": [
          "site.applyRebuild"
        ]
      },
      "site.announcePaths"
    ],
    "rebuildPathsAfterMigrations": [
      "site.planRebuild",
      {
        "atomic": [
          "site.applyRebuild"
        ]
      },
      "site.announcePaths"
    ],
    "reconcileMedia": [
      "media.reconcile"
    ],
    "reconcileMediaDelete": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.reconcileDelete"
    ],
    "reconcileMediaReport": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.reconcile"
    ],
    "removeAutoRedirect": [
      "authn.requireUser",
      "authz.require:redirects.write",
      "redirects.removeAuto",
      "redirects.export"
    ],
    "renameMediaFolder": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.renameFolder"
    ],
    "renderRedirects": [
      "redirects.render",
      "authz.fields:redirectRules?shape=array"
    ],
    "resolvePage": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "redirects.lookup",
      "site.resolve:pages?home=home&status=published&fallback=true",
      "site.resolveLinks:pages?home=home&status=published&fallback=true",
      "authz.fields:pages?shape=item"
    ],
    "resumePaths": [
      "site.resumePaths"
    ],
    "serveMediaFile": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.serve",
      "authz.fields:mediaFile?shape=file"
    ],
    "setNotifications": [
      "authn.requireUser",
      "authz.require:notifications.write",
      {
        "atomic": [
          "content.set:notifications"
        ]
      },
      "events.emit:notifications.updated",
      "events.relay"
    ],
    "setPassword": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authn.setPassword",
      "events.emit:user.passwordSet",
      "events.relay"
    ],
    "setProfile": [
      "authn.requireUser",
      "authz.require:profile.write",
      {
        "atomic": [
          "content.set:profile"
        ]
      },
      "events.emit:profile.updated",
      "events.relay"
    ],
    "setRedirects": [
      "authn.requireUser",
      "authz.require:redirects.write",
      "validate.check:redirects.rules",
      "redirects.validate",
      "content.set:redirects",
      "redirects.export"
    ],
    "setSettings": [
      "authn.requireUser",
      "authz.require:settings.write",
      "validate.check:settings.navigation",
      {
        "atomic": [
          "content.set:settings"
        ]
      },
      "events.emit:settings.updated",
      "events.relay"
    ],
    "updateMedia": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.update",
      "events.emit:media.updated",
      "events.relay"
    ],
    "updateNews": [
      "authn.requireUser",
      "authz.require:news.write",
      "validate.check:news.body",
      "validate.sanitize:news.body",
      "validate.check:news.body",
      {
        "atomic": [
          "content.update:news"
        ]
      },
      "events.emit:news.updated",
      "events.relay"
    ],
    "updatePage": [
      "authn.requireUser",
      "authz.require:pages.write",
      "validate.check:pages.body",
      "validate.sanitize:pages.body",
      "validate.check:pages.body",
      {
        "atomic": [
          "content.update:pages",
          "site.indexPath:pages"
        ]
      },
      "site.announcePaths",
      "events.emit:page.updated",
      "events.relay"
    ],
    "updateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.requireRecentAuth:300",
      "authz.validateRoles:roles",
      "authn.updateUser",
      "events.emit:user.updated",
      "events.relay"
    ],
    "uploadMedia": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.upload",
      "events.emit:media.uploaded",
      "events.relay"
    ]
  },
  "triggers": [
    {
      "http": "POST /login",
      "pipeline": "login"
    },
    {
      "http": "POST /logout",
      "pipeline": "logout"
    },
    {
      "http": "GET /me",
      "pipeline": "me"
    },
    {
      "http": "POST /me/password",
      "pipeline": "changePassword"
    },
    {
      "http": "POST /me/confirm-password",
      "pipeline": "confirmPassword"
    },
    {
      "http": "GET /users",
      "pipeline": "listUsers"
    },
    {
      "http": "POST /users",
      "pipeline": "createUser"
    },
    {
      "http": "GET /users/:id",
      "pipeline": "getUser"
    },
    {
      "http": "PATCH /users/:id",
      "pipeline": "updateUser"
    },
    {
      "http": "PUT /users/:id/password",
      "pipeline": "setPassword"
    },
    {
      "http": "DELETE /users/:id",
      "pipeline": "deleteUser"
    },
    {
      "http": "POST /users/:id/deactivate",
      "pipeline": "deactivateUser"
    },
    {
      "http": "POST /users/:id/activate",
      "pipeline": "activateUser"
    },
    {
      "http": "GET /settings",
      "pipeline": "getSettings"
    },
    {
      "http": "PUT /settings",
      "pipeline": "setSettings"
    },
    {
      "http": "GET /redirects",
      "pipeline": "getRedirects"
    },
    {
      "http": "PUT /redirects",
      "pipeline": "setRedirects"
    },
    {
      "http": "GET /redirects.json",
      "pipeline": "renderRedirects"
    },
    {
      "http": "POST /admin/paths/rebuild",
      "pipeline": "rebuildPaths"
    },
    {
      "http": "POST /admin/pages/path-preview",
      "pipeline": "previewPagePath"
    },
    {
      "http": "GET /site/*path",
      "pipeline": "resolvePage"
    },
    {
      "http": "GET /pages",
      "pipeline": "listPages"
    },
    {
      "http": "GET /admin/pages",
      "pipeline": "listAllPages"
    },
    {
      "http": "GET /admin/pages/:id",
      "pipeline": "readAnyPage"
    },
    {
      "http": "GET /pages/:id",
      "pipeline": "readPage"
    },
    {
      "http": "POST /pages",
      "pipeline": "createPage"
    },
    {
      "http": "PATCH /pages/:id",
      "pipeline": "updatePage"
    },
    {
      "http": "DELETE /pages/:id",
      "pipeline": "deletePage"
    },
    {
      "http": "DELETE /pages/:id/translations/:locale",
      "pipeline": "deletePageTranslation"
    },
    {
      "http": "POST /media",
      "pipeline": "uploadMedia"
    },
    {
      "http": "POST /admin/media/export",
      "pipeline": "exportMedia"
    },
    {
      "http": "POST /admin/media/reconcile",
      "pipeline": "reconcileMediaReport"
    },
    {
      "http": "POST /admin/media/reconcile/delete",
      "pipeline": "reconcileMediaDelete"
    },
    {
      "http": "GET /media/folders",
      "pipeline": "listMediaFolders"
    },
    {
      "http": "POST /media/folders",
      "pipeline": "createMediaFolder"
    },
    {
      "http": "PATCH /media/folders/*path",
      "pipeline": "renameMediaFolder"
    },
    {
      "http": "DELETE /media/folders/*path",
      "pipeline": "deleteMediaFolder"
    },
    {
      "http": "GET /media",
      "pipeline": "listMedia"
    },
    {
      "http": "GET /media/:id",
      "pipeline": "getMedia"
    },
    {
      "http": "GET /media/:id/file",
      "pipeline": "downloadMedia"
    },
    {
      "http": "GET /media/:id/:name",
      "pipeline": "serveMediaFile"
    },
    {
      "http": "PATCH /media/:id",
      "pipeline": "updateMedia"
    },
    {
      "http": "DELETE /media/:id",
      "pipeline": "deleteMedia"
    },
    {
      "http": "GET /admin/migrations",
      "pipeline": "listMigrations"
    },
    {
      "http": "POST /admin/migrations/apply",
      "pipeline": "applyMigrations"
    },
    {
      "http": "GET /admin/events/delivery",
      "pipeline": "eventsDeliveryStatus"
    },
    {
      "cron": "0 * * * *",
      "pipeline": "cleanupSessions"
    },
    {
      "cron": "* * * * *",
      "pipeline": "resumePaths"
    },
    {
      "cron": "30 3 * * *",
      "pipeline": "reconcileMedia"
    },
    {
      "http": "GET /news",
      "pipeline": "listNews"
    },
    {
      "http": "GET /admin/news",
      "pipeline": "listAllNews"
    },
    {
      "http": "GET /admin/news/:id",
      "pipeline": "readAnyNews"
    },
    {
      "http": "GET /news/:id",
      "pipeline": "readNews"
    },
    {
      "http": "POST /news",
      "pipeline": "createNews"
    },
    {
      "http": "PATCH /news/:id",
      "pipeline": "updateNews"
    },
    {
      "http": "DELETE /news/:id",
      "pipeline": "deleteNews"
    },
    {
      "http": "DELETE /news/:id/translations/:locale",
      "pipeline": "deleteNewsTranslation"
    },
    {
      "http": "GET /profile",
      "pipeline": "getProfile"
    },
    {
      "http": "PUT /profile",
      "pipeline": "setProfile"
    },
    {
      "http": "GET /notifications",
      "pipeline": "getNotifications"
    },
    {
      "http": "PUT /notifications",
      "pipeline": "setNotifications"
    },
    {
      "http": "GET /admin/redirects/auto",
      "pipeline": "listAutoRedirects"
    },
    {
      "http": "DELETE /admin/redirects/auto/*path",
      "pipeline": "removeAutoRedirect"
    },
    {
      "event": "site.pathsMoved",
      "pipeline": "pathsMovedRedirects"
    },
    {
      "event": "migrations.applied",
      "pipeline": "rebuildPathsAfterMigrations"
    }
  ]
}
