{
  "pipelines": {
    "activateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.activateUser"
    ],
    "adminSchemaModel": [
      "authn.requireUser",
      "content.describeModel",
      "authz.describePipelineAccess"
    ],
    "anonymizeAuditUser": [
      "audit.anonymize"
    ],
    "auditAuth": [
      "audit.record"
    ],
    "brokenLinks": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "links.report"
    ],
    "brokenReferences": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.report"
    ],
    "changePassword": [
      "authn.requireUser",
      "authn.changePassword"
    ],
    "checkLinks": [
      "links.check"
    ],
    "cleanupSessions": [
      "authn.cleanupSessions"
    ],
    "createMediaFolder": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.createFolder"
    ],
    "createPage": [
      "authn.requireUser",
      "authz.require:pages.write",
      "validate.check:pages.body",
      "validate.sanitize:pages.body",
      "validate.check:pages.body",
      "validate.check:pages.slug",
      "validate.check:pages.accent",
      {
        "atomic": [
          "references.check:pages",
          "content.create:pages",
          "revisions.record:pages",
          "references.index:pages",
          "links.extract:pages"
        ]
      },
      "events.emit:page.created",
      "events.relay"
    ],
    "createUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authz.validateRoles:roles",
      "authn.createUser",
      "events.emit:user.created",
      "events.relay"
    ],
    "deactivateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.deactivateUser",
      "events.emit:user.deactivated",
      "events.relay"
    ],
    "deleteMedia": [
      "authn.requireUser",
      "authz.require:media.delete",
      "references.guard:media",
      "media.remove",
      "images.remove",
      "events.emit:media.deleted",
      "events.relay"
    ],
    "deleteMediaFolder": [
      "authn.requireUser",
      "authz.require:media.delete",
      "media.listFolderItems",
      "references.guardAll:media",
      "media.removeFolder",
      "images.removeMany",
      "events.emit:media.deleted",
      "events.relay"
    ],
    "deletePage": [
      "authn.requireUser",
      "authz.require:pages.delete",
      {
        "atomic": [
          "references.guard:pages",
          "content.remove:pages",
          "revisions.remove:pages",
          "references.unindex:pages",
          "links.unextract:pages"
        ]
      },
      "events.emit:page.deleted",
      "events.relay"
    ],
    "deletePageTranslation": [
      "authn.requireUser",
      "authz.require:pages.write",
      {
        "atomic": [
          "content.removeTranslation:pages",
          "revisions.removeTranslation:pages",
          "references.index:pages",
          "links.extract:pages"
        ]
      },
      "events.emit:page.translationRemoved",
      "events.relay"
    ],
    "deleteUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.deleteUser",
      "events.emit:user.deleted?with=result",
      "events.relay"
    ],
    "deliveryBuildCheck": [
      "delivery.checkBuild"
    ],
    "downloadMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.download"
    ],
    "eventsDeliveryStatus": [
      "authn.requireUser",
      "authz.require:system.manage",
      "events.readDeliveryStatus"
    ],
    "exportMedia": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.export:<exportDir>",
      "images.export:<exportDir>"
    ],
    "generateImageVariants": [
      "images.generate"
    ],
    "getMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.get",
      "images.attach"
    ],
    "getRedirects": [
      "authn.identifyUser",
      "authz.require:redirects.read",
      "content.get:redirects"
    ],
    "getSettings": [
      "authn.identifyUser",
      "authz.require:settings.read",
      "content.get:settings",
      "site.resolveLinks:settings?home=home&status=published&fallback=true"
    ],
    "getUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.getUser"
    ],
    "imagesStatus": [
      "authn.requireUser",
      "authz.require:images.read",
      "images.readStatus"
    ],
    "insightsManifest": [
      "authn.requireUser",
      "authz.require:insights.read",
      "insights.readManifest"
    ],
    "insightsStats": [
      "authn.requireUser",
      "authz.require:insights.read",
      "insights.readStats"
    ],
    "labelPageRevision": [
      "authn.requireUser",
      "authz.require:pages.write",
      "revisions.label:pages"
    ],
    "listAllPages": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "content.list:pages"
    ],
    "listImageSizes": [
      "authn.requireUser",
      "authz.require:images.read",
      "images.listSizes"
    ],
    "listMedia": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.list",
      "images.attach"
    ],
    "listMediaFolders": [
      "authn.requireUser",
      "authz.require:media.read",
      "media.listFolders"
    ],
    "listPages": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "content.list:pages?status=published"
    ],
    "listUsers": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.listUsers"
    ],
    "login": [
      "ratelimit.check:login",
      "authn.login",
      "events.emit:auth.loggedIn",
      "events.relay"
    ],
    "logout": [
      "authn.requireUser",
      "authn.logout",
      "events.emit:auth.loggedOut",
      "events.relay"
    ],
    "me": [
      "authn.requireUser",
      "authn.loadIdentity"
    ],
    "mediaDependents": [
      "delivery.markDependents:media"
    ],
    "mediaReferrers": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.referrers:media"
    ],
    "mediaReferrersMany": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.referrersMany:media"
    ],
    "pageDependents": [
      "delivery.markDependents:pages"
    ],
    "pagePublishStatus": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "delivery.readStatus:pages"
    ],
    "pageReferrers": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.referrers:pages"
    ],
    "pageReferrersMany": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.referrersMany:pages"
    ],
    "pageRevision": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "revisions.read:pages"
    ],
    "pageRevisions": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "revisions.list:pages"
    ],
    "pagesStaleStatus": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "delivery.readStaleStatus"
    ],
    "pruneAudit": [
      "audit.prune"
    ],
    "pruneImages": [
      "authn.requireUser",
      "authz.require:images.manage",
      "images.prune"
    ],
    "pruneRevisions": [
      "revisions.prune"
    ],
    "publishAllPages": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "delivery.markAll:pages",
      "redirects.export"
    ],
    "publishPage": [
      "delivery.publish:pages",
      "delivery.requestLlms"
    ],
    "readAnyPage": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "content.get:pages"
    ],
    "readPage": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "content.get:pages?status=published"
    ],
    "reassignRevisionAuthor": [
      "authn.verifyUser:result.reassignTo",
      "revisions.reassignAuthor"
    ],
    "rebuildLinks": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "links.rebuild"
    ],
    "rebuildReferences": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "references.rebuild"
    ],
    "reconcileMedia": [
      "media.reconcile"
    ],
    "reconcileMediaDelete": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.reconcileDelete"
    ],
    "reconcileMediaReport": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.reconcile"
    ],
    "registerImageSizes": [
      "authn.requireUser",
      "authz.require:images.write",
      "images.register"
    ],
    "registerImageSizesBoot": [
      "images.register"
    ],
    "renameMediaFolder": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.renameFolder"
    ],
    "renderRedirects": [
      "redirects.render"
    ],
    "repairPublicMedia": [
      "authn.requireUser",
      "authz.require:media.manage",
      "media.syncPublic",
      "images.syncPublic"
    ],
    "replicate": [
      "replication.sync"
    ],
    "replicationPoints": [
      "authn.requireUser",
      "authz.require:system.manage",
      "replication.listPoints"
    ],
    "replicationRestore": [
      "authn.requireUser",
      "authz.require:system.manage",
      "replication.prepareRestore"
    ],
    "replicationSnapshot": [
      "authn.requireUser",
      "authz.require:system.manage",
      "replication.snapshot"
    ],
    "replicationStatus": [
      "authn.requireUser",
      "authz.require:system.manage",
      "replication.readStatus"
    ],
    "resolvePage": [
      "authn.identifyUser",
      "authz.require:pages.read",
      "redirects.lookup",
      "site.resolve:pages?home=home&status=published&fallback=true",
      "site.resolveLinks:pages?home=home&status=published&fallback=true"
    ],
    "restorePageRevision": [
      "authn.requireUser",
      "authz.require:pages.write",
      "revisions.restore:pages",
      "validate.check:pages.body",
      "validate.sanitize:pages.body",
      "validate.check:pages.body",
      "validate.check:pages.slug",
      "validate.check:pages.accent",
      {
        "atomic": [
          "references.check:pages",
          "content.update:pages",
          "revisions.record:pages",
          "references.index:pages",
          "links.extract:pages"
        ]
      },
      "revisions.reportRestore",
      "events.emit:page.restored",
      "events.relay"
    ],
    "resumeImages": [
      "images.resume"
    ],
    "resumeStalePages": [
      "delivery.resumeStale"
    ],
    "retryAnonymizeAuditUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "audit.anonymize"
    ],
    "retryFailedImages": [
      "authn.requireUser",
      "authz.require:images.manage",
      "images.retryFailed"
    ],
    "retryReassignRevisionAuthor": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.verifyUser:reassignTo",
      "revisions.reassignAuthor"
    ],
    "retryStalePages": [
      "authn.requireUser",
      "authz.require:pages.manage",
      "delivery.retryStale"
    ],
    "scanReferences": [
      "references.scan"
    ],
    "serveImageVariant": [
      "authn.identifyUser",
      "authz.require:media.read",
      "images.serve"
    ],
    "serveMediaFile": [
      "authn.identifyUser",
      "authz.require:media.read",
      "media.serve"
    ],
    "setPassword": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authn.setPassword"
    ],
    "setRedirects": [
      "authn.requireUser",
      "authz.require:redirects.write",
      "validate.check:redirects.rules",
      "redirects.validate",
      "content.set:redirects",
      "redirects.export"
    ],
    "setSettings": [
      "authn.requireUser",
      "authz.require:settings.write",
      "validate.check:settings.navigation",
      {
        "atomic": [
          "content.set:settings"
        ]
      },
      "events.emit:settings.updated",
      "events.relay"
    ],
    "settingsDependents": [
      "delivery.markDependents:settings",
      "delivery.requestLlms"
    ],
    "sweepRateLimits": [
      "ratelimit.sweep"
    ],
    "syncImages": [
      "authn.requireUser",
      "authz.require:images.manage",
      "images.sync"
    ],
    "syncPublicMedia": [
      "media.syncPublic",
      "images.syncPublic"
    ],
    "unpublishPage": [
      "delivery.unpublish:pages",
      "delivery.requestLlms"
    ],
    "updateMedia": [
      "authn.requireUser",
      "authz.require:media.write",
      "media.update",
      "events.emit:media.updated",
      "events.relay"
    ],
    "updatePage": [
      "authn.requireUser",
      "authz.require:pages.write",
      "validate.check:pages.body",
      "validate.sanitize:pages.body",
      "validate.check:pages.body",
      "validate.check:pages.slug",
      "validate.check:pages.accent",
      {
        "atomic": [
          "references.check:pages",
          "content.update:pages",
          "revisions.record:pages",
          "references.index:pages",
          "links.extract:pages"
        ]
      },
      "events.emit:page.updated",
      "events.relay"
    ],
    "updateUser": [
      "authn.requireUser",
      "authz.require:users.manage",
      "authz.validateRoles:roles",
      "authn.updateUser",
      "events.emit:user.updated",
      "events.relay"
    ],
    "uploadMedia": [
      "authn.requireUser",
      "authz.require:media.write",
      "sanitize.svg",
      "media.upload",
      "events.emit:media.uploaded",
      "events.relay"
    ]
  },
  "triggers": [
    {
      "http": "POST /login",
      "pipeline": "login"
    },
    {
      "http": "POST /logout",
      "pipeline": "logout"
    },
    {
      "http": "GET /me",
      "pipeline": "me"
    },
    {
      "http": "POST /me/password",
      "pipeline": "changePassword"
    },
    {
      "http": "GET /users",
      "pipeline": "listUsers"
    },
    {
      "http": "POST /users",
      "pipeline": "createUser"
    },
    {
      "http": "GET /users/:id",
      "pipeline": "getUser"
    },
    {
      "http": "PATCH /users/:id",
      "pipeline": "updateUser"
    },
    {
      "http": "PUT /users/:id/password",
      "pipeline": "setPassword"
    },
    {
      "http": "DELETE /users/:id",
      "pipeline": "deleteUser"
    },
    {
      "http": "POST /users/:id/deactivate",
      "pipeline": "deactivateUser"
    },
    {
      "http": "POST /users/:id/activate",
      "pipeline": "activateUser"
    },
    {
      "http": "GET /admin/publish-status/pages/:id",
      "pipeline": "pagePublishStatus"
    },
    {
      "http": "POST /admin/publish-all/pages",
      "pipeline": "publishAllPages"
    },
    {
      "http": "GET /admin/publish-status/pages",
      "pipeline": "pagesStaleStatus"
    },
    {
      "http": "POST /admin/publish-stale/pages/retry",
      "pipeline": "retryStalePages"
    },
    {
      "http": "POST /admin/media/repair-public",
      "pipeline": "repairPublicMedia"
    },
    {
      "http": "GET /admin/references/broken",
      "pipeline": "brokenReferences"
    },
    {
      "http": "GET /admin/references/to/pages",
      "pipeline": "pageReferrersMany"
    },
    {
      "http": "GET /admin/references/to/pages/:id",
      "pipeline": "pageReferrers"
    },
    {
      "http": "GET /admin/references/to/media",
      "pipeline": "mediaReferrersMany"
    },
    {
      "http": "GET /admin/references/to/media/:id",
      "pipeline": "mediaReferrers"
    },
    {
      "http": "POST /admin/references/rebuild",
      "pipeline": "rebuildReferences"
    },
    {
      "http": "GET /admin/links/broken",
      "pipeline": "brokenLinks"
    },
    {
      "http": "POST /admin/links/rebuild",
      "pipeline": "rebuildLinks"
    },
    {
      "http": "GET /settings",
      "pipeline": "getSettings"
    },
    {
      "http": "PUT /settings",
      "pipeline": "setSettings"
    },
    {
      "http": "GET /redirects",
      "pipeline": "getRedirects"
    },
    {
      "http": "PUT /redirects",
      "pipeline": "setRedirects"
    },
    {
      "http": "GET /redirects.json",
      "pipeline": "renderRedirects"
    },
    {
      "http": "GET /site/*path",
      "pipeline": "resolvePage"
    },
    {
      "http": "GET /pages",
      "pipeline": "listPages"
    },
    {
      "http": "GET /admin/pages",
      "pipeline": "listAllPages"
    },
    {
      "http": "GET /admin/pages/:id",
      "pipeline": "readAnyPage"
    },
    {
      "http": "GET /pages/:id",
      "pipeline": "readPage"
    },
    {
      "http": "POST /pages",
      "pipeline": "createPage"
    },
    {
      "http": "PATCH /pages/:id",
      "pipeline": "updatePage"
    },
    {
      "http": "DELETE /pages/:id",
      "pipeline": "deletePage"
    },
    {
      "http": "DELETE /pages/:id/translations/:locale",
      "pipeline": "deletePageTranslation"
    },
    {
      "http": "POST /media",
      "pipeline": "uploadMedia"
    },
    {
      "http": "POST /admin/media/export",
      "pipeline": "exportMedia"
    },
    {
      "http": "POST /admin/media/reconcile",
      "pipeline": "reconcileMediaReport"
    },
    {
      "http": "POST /admin/media/reconcile/delete",
      "pipeline": "reconcileMediaDelete"
    },
    {
      "http": "GET /media/folders",
      "pipeline": "listMediaFolders"
    },
    {
      "http": "POST /media/folders",
      "pipeline": "createMediaFolder"
    },
    {
      "http": "PATCH /media/folders/*path",
      "pipeline": "renameMediaFolder"
    },
    {
      "http": "DELETE /media/folders/*path",
      "pipeline": "deleteMediaFolder"
    },
    {
      "http": "GET /media",
      "pipeline": "listMedia"
    },
    {
      "http": "GET /media/:id",
      "pipeline": "getMedia"
    },
    {
      "http": "GET /media/:id/file",
      "pipeline": "downloadMedia"
    },
    {
      "http": "GET /media/:id/variants/:file",
      "pipeline": "serveImageVariant"
    },
    {
      "http": "GET /media/:id/:name",
      "pipeline": "serveMediaFile"
    },
    {
      "http": "PATCH /media/:id",
      "pipeline": "updateMedia"
    },
    {
      "http": "DELETE /media/:id",
      "pipeline": "deleteMedia"
    },
    {
      "http": "PUT /admin/images/sizes",
      "pipeline": "registerImageSizes"
    },
    {
      "http": "GET /admin/images/sizes",
      "pipeline": "listImageSizes"
    },
    {
      "http": "POST /admin/images/sync",
      "pipeline": "syncImages"
    },
    {
      "http": "POST /admin/images/prune",
      "pipeline": "pruneImages"
    },
    {
      "http": "POST /admin/images/retry-failed",
      "pipeline": "retryFailedImages"
    },
    {
      "http": "GET /admin/images/status",
      "pipeline": "imagesStatus"
    },
    {
      "http": "GET /admin/replication/status",
      "pipeline": "replicationStatus"
    },
    {
      "http": "GET /admin/replication/points",
      "pipeline": "replicationPoints"
    },
    {
      "http": "POST /admin/replication/snapshot",
      "pipeline": "replicationSnapshot"
    },
    {
      "http": "POST /admin/replication/restore",
      "pipeline": "replicationRestore"
    },
    {
      "http": "GET /admin/insights/manifest",
      "pipeline": "insightsManifest"
    },
    {
      "http": "GET /admin/insights/stats",
      "pipeline": "insightsStats"
    },
    {
      "http": "GET /admin/events/delivery",
      "pipeline": "eventsDeliveryStatus"
    },
    {
      "cron": "30 2 * * *",
      "pipeline": "scanReferences"
    },
    {
      "cron": "0 3 * * *",
      "pipeline": "checkLinks"
    },
    {
      "cron": "0 * * * *",
      "pipeline": "cleanupSessions"
    },
    {
      "cron": "*/5 * * * *",
      "pipeline": "sweepRateLimits"
    },
    {
      "cron": "*/5 * * * *",
      "pipeline": "resumeImages"
    },
    {
      "cron": "30 3 * * *",
      "pipeline": "reconcileMedia"
    },
    {
      "cron": "45 3 * * *",
      "pipeline": "syncPublicMedia"
    },
    {
      "cron": "*/5 * * * *",
      "pipeline": "resumeStalePages"
    },
    {
      "cron": "* * * * *",
      "pipeline": "replicate"
    },
    {
      "cron": "15 3 * * *",
      "pipeline": "pruneRevisions"
    },
    {
      "event": "auth.loggedIn",
      "pipeline": "auditAuth"
    },
    {
      "event": "auth.loggedOut",
      "pipeline": "auditAuth"
    },
    {
      "event": "page.created",
      "pipeline": "publishPage"
    },
    {
      "event": "page.updated",
      "pipeline": "publishPage"
    },
    {
      "event": "page.restored",
      "pipeline": "publishPage"
    },
    {
      "event": "page.deleted",
      "pipeline": "unpublishPage"
    },
    {
      "event": "page.translationRemoved",
      "pipeline": "publishPage"
    },
    {
      "event": "page.created",
      "pipeline": "pageDependents"
    },
    {
      "event": "page.updated",
      "pipeline": "pageDependents"
    },
    {
      "event": "page.deleted",
      "pipeline": "pageDependents"
    },
    {
      "event": "page.restored",
      "pipeline": "pageDependents"
    },
    {
      "event": "page.translationRemoved",
      "pipeline": "pageDependents"
    },
    {
      "event": "settings.updated",
      "pipeline": "settingsDependents"
    },
    {
      "event": "media.updated",
      "pipeline": "mediaDependents"
    },
    {
      "event": "media.deleted",
      "pipeline": "mediaDependents"
    },
    {
      "event": "media.uploaded",
      "pipeline": "generateImageVariants"
    },
    {
      "http": "POST /admin/users/:id/audit/anonymize",
      "pipeline": "retryAnonymizeAuditUser"
    },
    {
      "event": "user.deleted",
      "pipeline": "anonymizeAuditUser"
    },
    {
      "cron": "45 3 * * *",
      "pipeline": "pruneAudit"
    },
    {
      "http": "POST /admin/users/:id/revisions/reassign",
      "pipeline": "retryReassignRevisionAuthor"
    },
    {
      "event": "user.deleted",
      "pipeline": "reassignRevisionAuthor"
    },
    {
      "http": "GET /admin/pages/:id/revisions",
      "pipeline": "pageRevisions"
    },
    {
      "http": "GET /admin/pages/:id/revisions/:revisionId",
      "pipeline": "pageRevision"
    },
    {
      "http": "PATCH /admin/pages/:id/revisions/:revisionId",
      "pipeline": "labelPageRevision"
    },
    {
      "http": "POST /admin/pages/:id/revisions/:revisionId/restore",
      "pipeline": "restorePageRevision"
    }
  ]
}
